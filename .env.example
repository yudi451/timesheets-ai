# Copy to .env (or just export these) before running.
# Only the API key for the provider you select via spring.ai.model.chat is required.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SendGrid — leave blank to run in dry-run mode (the app logs the email instead of sending).
SENDGRID_API_KEY=

# Verified sender on your SendGrid account.
EMAIL_FROM=
